# ---------------------------------------------------------------------------
# Client configuration — PUBLIC
# ---------------------------------------------------------------------------
# Every value below ships inside the JS bundle and every visitor's browser can
# read it. That is by design, not an oversight. Security comes from Security
# Rules and App Check, never from hiding these.
#
# Restrict the API key by HTTP referrer and by API in the Google Cloud console
# anyway — it limits what a copied key is good for.
#
# Copy to .env.local (gitignored) and fill in from the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Region your callables are deployed to. The client must match, or every call
# 404s. Defaults to europe-west2 when unset.
VITE_FIREBASE_REGION=

# reCAPTCHA v3 SITE key for App Check. Public — it ships in the bundle.
# The matching SECRET key goes in the Firebase console and nowhere else.
# Leave empty to skip App Check entirely rather than half-configure it.
VITE_APP_CHECK_SITE_KEY=

# Optional. Lets a developer machine reach a LIVE project while App Check is
# enforced. Register the token in the console; revoke it when you are done.
# Never commit a real value.
VITE_APP_CHECK_DEBUG_TOKEN=


# ---------------------------------------------------------------------------
# Mode flags — keep these OUT of .env.local
# ---------------------------------------------------------------------------
# Vite loads `.env.local` in EVERY mode and ranks it ABOVE `.env.production`.
# A mode flag there silently overrides the production build. Split them:
#
#   .env.local               connection config only (the values above)
#   .env.development.local   what `yarn dev` runs against    (gitignored)
#   .env.production          what `yarn build` produces      (committed)
#
#   VITE_USE_EMULATORS=true    local Firebase Emulator Suite
#   VITE_USE_EMULATORS=false   the live project


# ---------------------------------------------------------------------------
# Cloud Functions — SERVER-ONLY
# ---------------------------------------------------------------------------
# Set in packages/functions/.env.local for emulator runs. `firebase deploy`
# ignores .env.local, so a deployed function never sees these.
#
# The emulator cannot produce App Check attestation, so local runs opt out.
# Name it per-application so one project's local setting can never affect
# another's.
#
# MYAPP_ALLOW_UNVERIFIED=true

# Anything genuinely secret — a Resend API key, a third-party token — belongs in
# Secret Manager and is referenced by name at deploy time, never written here
# and never committed. See docs/environment-variables.md.
