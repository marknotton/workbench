{
  "name": "workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable Firebase application foundation: authentication, membership, callable hardening and rules templates.",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "lint": "eslint packages --max-warnings 0",
    "format": "prettier --write \"packages/**/*.ts\" \"docs/**/*.md\" \"*.md\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
